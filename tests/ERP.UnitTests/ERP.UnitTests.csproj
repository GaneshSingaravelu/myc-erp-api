<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\ERP.SharedKernel\ERP.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Core\ERP.Application.Abstractions\ERP.Application.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Persistence\ERP.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Identity\ERP.Identity.csproj" />
    <!-- Host reference: the role DELETE withdrawal is a contract of the controller itself.
         Asserting it needs the controller, not the service beneath it — the whole point of
         the withdrawal being that no service is reached at all. -->
    <ProjectReference Include="..\..\src\Host\ERP.Api\ERP.Api.csproj" />
    <!-- DbMigrator reference: design-time provider selection is a contract of
         MasterDbContextFactory, which lives in the migrator tool. Asserting that
         Database:Provider drives the design-time engine — and fails closed — requires the
         factory type itself. -->
    <ProjectReference Include="..\..\tools\ERP.DbMigrator\ERP.DbMigrator.csproj" />
  </ItemGroup>

</Project>
