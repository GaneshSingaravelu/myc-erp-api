<!--
  ERP.Application.Abstractions — CQRS contracts, interfaces, pipeline behaviors.
  Contains: ICommand, IQuery, IRepository, IUnitOfWork, validation pipeline.
  Rule: References SharedKernel only. NO EF Core, NO ASP.NET references.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ERP.SharedKernel\ERP.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mediator: MIT-licensed CQRS mediator (replaces MediatR RPL-1.5) -->
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />

    <!-- FluentValidation: Declarative validation rules for commands/queries -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Logging abstractions — so we can log in pipeline behaviors without depending on Serilog -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

</Project>
