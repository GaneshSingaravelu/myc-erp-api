<!--
  ERP.Infrastructure — Cross-cutting concerns: multi-tenancy, caching, logging.
  Contains: TenantMiddleware, CacheService, Serilog setup.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ERP.SharedKernel\ERP.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Core\ERP.Application.Abstractions\ERP.Application.Abstractions.csproj" />
    <ProjectReference Include="..\ERP.Persistence\ERP.Persistence.csproj" />
    <ProjectReference Include="..\ERP.Persistence.SqlServer\ERP.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\ERP.Persistence.PostgreSql\ERP.Persistence.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core framework reference for middleware, HttpContext, etc. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- Serilog: Structured logging (replaces default Microsoft.Extensions.Logging) -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />

    <!-- Redis distributed cache -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.11" />

    <!-- In-memory caching -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
  </ItemGroup>

</Project>
