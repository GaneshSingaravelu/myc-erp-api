<!--
  ERP.Identity — JWT authentication, user management, roles, permissions.
  Contains: Token service, auth service, password hashing.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ERP.SharedKernel\ERP.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Core\ERP.Application.Abstractions\ERP.Application.Abstractions.csproj" />
    <ProjectReference Include="..\ERP.Persistence\ERP.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core framework reference (includes JWT Bearer) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- BCrypt for secure password hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- JWT token creation and validation -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
  </ItemGroup>

</Project>
