{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "MasterDb": "REPLACE_ME — set via environment variable or user-secrets"
  },

  "AllowedOrigins": [
    "http://localhost:4200"
  ],

  "JwtSettings": {
    "SecretKey": "REPLACE_ME — set via environment variable or user-secrets",
    "Issuer": "ERP.Api",
    "Audience": "ERP.Angular",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "Tenants": [
    {
      "Id": "00000000-0000-0000-0000-000000000000",
      "Identifier": "REPLACE_ME",
      "Name": "REPLACE_ME",
      "ConnectionString": "REPLACE_ME — set via environment variable or user-secrets",
      "DbProvider": "SqlServer",
      "IsActive": true
    }
  ],

  "Email": {
    "Host": "REPLACE_ME — set via environment variable or user-secrets",
    "Port": 587,
    "SenderEmail": "noreply@erp.local",
    "SenderName": "ERP System",
    "UserName": "REPLACE_ME",
    "Password": "REPLACE_ME",
    "UseSsl": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
