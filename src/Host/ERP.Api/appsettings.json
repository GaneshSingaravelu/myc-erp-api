{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AllowedOrigins": [
    "http://localhost:4200"
  ],

  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!ChangeInProduction!",
    "Issuer": "ERP.Api",
    "Audience": "ERP.Angular",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "SeedSettings": {
    "DefaultAdminPassword": "Admin@123"
  },

  "Tenants": [
    {
      "Id": "11111111-1111-1111-1111-111111111111",
      "Identifier": "dev-tenant",
      "Name": "Development Tenant",
      "ConnectionString": "Server=localhost;Database=ERP_Dev;Trusted_Connection=true;TrustServerCertificate=true;",
      "DbProvider": "SqlServer",
      "IsActive": true
    }
  ],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
